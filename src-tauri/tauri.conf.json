{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumina PDF",
  "version": "0.1.0",
  "identifier": "com.easy-pdf-reader.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lumina PDF",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval'; img-src 'self' data: blob: asset: http://asset.localhost http://pdf-page.localhost *; connect-src 'self' ipc: http://ipc.localhost http://pdf-page.localhost *;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": [
      "pdfium.dll"
    ]
  }
}
